{
  "name": "pokestadium-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "python3 tools/check_stadium_assets.py --extract-if-missing && python3 tools/extract_stadium_announcer.py --if-missing && vite",
    "build": "python3 tools/check_stadium_assets.py --extract-if-missing && python3 tools/extract_stadium_announcer.py --if-missing && tsc && vite build",
    "preview": "vite preview",
    "test:gameplay": "node tools/test_gameplay_regressions.mjs",
    "test:maps": "node tools/test_map_layouts.mjs",
    "balance:xp": "node tools/xp_pacing.mjs",
    "extract:stadium": "python3 tools/extract_stadium_assets.py && python3 tools/extract_stadium_announcer.py --if-missing"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
